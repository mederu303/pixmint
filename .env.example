# コントラクトのアドレスがあるチェーンだけ画面に出る
# NEXT_PUBLIC_PIXMINT_1=0x...          # Ethereum
# NEXT_PUBLIC_PIXMINT_8453=0x...       # Base
# NEXT_PUBLIC_PIXMINT_11155111=0x...   # Sepolia
# NEXT_PUBLIC_PIXMINT_84532=0x...      # Base Sepolia
NEXT_PUBLIC_PIXMINT_31337=0x5fbdb2315678afecb367f032d93f642f64180aa3
